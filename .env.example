NODE_ENV=development
PORT=3000
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Optional locally. Required on Render to share throttles across instances.
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-a-random-secret
APP_ORIGIN=http://localhost:3000
# Optional password reset delivery. Verify the sending domain with Resend first.
RESEND_API_KEY=
MAIL_FROM=Secure Login Demo <login@example.com>
